
QWidget {
    background-color: #101827;
    color: #F1F5F9;
    font-family: "Segoe UI";
    font-size: 15px;
}

QFrame#panel {
    background-color: #1B2638;
    border: 1px solid #303E53;
    border-radius: 18px;
}

QFrame#gameCard {
    background-color: #25354B;
    border: 1px solid #3B4B60;
    border-radius: 12px;
}

QLabel {
    background: transparent;
    border: none;
}

QLabel#pageTitle {
    color: #F8FAFC;
    font-size: 30px;
    font-weight: 800;
}

QLabel#subtitle {
    color: #94A3B8;
    font-size: 14px;
}

QLabel#cardTitle {
    color: #FFFFFF;
    font-size: 19px;
    font-weight: 700;
}

QPushButton {
    background-color: #29374B;
    color: #F1F5F9;
    border: 1px solid #3B4B60;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 600;
    padding: 10px 18px;
    min-height: 30px;
}

QPushButton:hover {
    background-color: #354963;
    border-color: #64748B;
}

QPushButton:pressed {
    background-color: #233247;
}

QPushButton#primaryButton {
    background-color: #2563EB;
    border-color: #3B82F6;
    color: white;
}

QPushButton#primaryButton:hover {
    background-color: #3B82F6;
}

QPushButton#exitButton:hover {
    background-color: #713044;
    border-color: #C25A75;
}

QPushButton:disabled {
    background-color: #202B3D;
    color: #728198;
    border-color: #303E53;
}

QLabel#questionText {
    color: #FFFFFF;
    font-size: 27px;
    font-weight: 700;
    padding: 12px;
}

QLabel#answerText {
    color: #4ADE80;
    font-size: 21px;
    font-weight: 700;
    padding: 12px;
}

QFrame#playerCard {
    background-color: #1B2638;
    border: 2px solid #34445D;
    border-radius: 16px;
}

QFrame#playerCard[state="active"] {
    background-color: #18365B;
    border: 2px solid #3B82F6;
}

QFrame#playerCard[state="queued"] {
    border: 2px solid #EAB308;
}

QFrame#playerCard[state="correct"] {
    background-color: #173D30;
    border: 2px solid #22C55E;
}

QFrame#playerCard[state="wrong"] {
    background-color: #45232D;
    border: 2px solid #EF4444;
}

QLabel#playerAvatar {
    color: #93C5FD;
    font-size: 36px;
    font-weight: 800;
    padding: 12px;
}

QPushButton#correctButton {
    background-color: #15803D;
    color: white;
}

QPushButton#correctButton:hover {
    background-color: #16A34A;
}

QPushButton#wrongButton {
    background-color: #B91C1C;
    color: white;
}

QPushButton#wrongButton:hover {
    background-color: #DC2626;
}

QDialog {
    background-color: #1B2638;
}

QDialog QLabel {
    font-size: 18px;
    padding: 15px;
}
